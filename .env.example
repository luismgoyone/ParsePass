# Copy to .env.local for local development. Never commit real values.
# The app builds and its tests pass with none of these set.

# Anthropic API key used by /api/extract to structure resume text. Server-only: never exposed to the browser.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for extraction (defaults to a current Sonnet model).
# ANTHROPIC_MODEL=

# Upstash Redis (rate limiting for /api/extract). When unset, rate limiting is disabled.
# The Vercel Marketplace Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: conversions allowed per visitor per day (default 5).
# RATE_LIMIT_PER_DAY=
